</style>
</head>
<body>
<header>
  <h1>OTG Ground Station</h1>
  <div class="row" style="flex:0 1 auto">
    <span id="modeBadge" class="badge">mode</span>
    <span id="otgBadge" class="badge">otg</span>
  </div>
</header>
<main>
  <section>
    <h2>RX Mode</h2>
    <div class="row">
      <button class="primary" onclick="setMode('apfpv')">APFPV</button>
      <button class="primary" onclick="setMode('wfb')">WFB</button>
    </div>
    <label>Status</label>
    <pre id="modeStatus"></pre>
  </section>

  <section>
    <h2>APFPV</h2>
    <label>SSID</label>
    <input id="apSsid" autocomplete="off">
    <label>Password</label>
    <input id="apPassword" type="password" placeholder="unchanged" autocomplete="off">
    <div class="row" style="margin-top:10px">
      <button onclick="saveApfpv()">Save APFPV</button>
      <button onclick="postAction('apfpv-reset')">Reset APFPV</button>
    </div>
  </section>

  <section>
    <h2>WFB</h2>
    <label>Channel</label>
    <input id="wfbChannel" inputmode="numeric">
    <label>Bandwidth</label>
    <input id="wfbBandwidth" inputmode="numeric">
    <label>TX Power</label>
    <input id="wfbTxpower">
    <label>Adaptive Link</label>
    <select id="wfbAdaptive"><option value="">unchanged</option><option value="true">true</option><option value="false">false</option></select>
    <button style="margin-top:10px" onclick="saveWfb()">Save WFB</button>
  </section>

  <section>
    <h2>Forwarder</h2>
    <div class="row">
      <button onclick="postAction('restart-forwarder')">Restart Forwarder</button>
