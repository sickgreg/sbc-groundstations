#!/usr/bin/env python3
import argparse
import html
import json
import os
import subprocess
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


GSMENU = "/usr/bin/gsmenu.sh"
OTG_RX_MODE = "/usr/sbin/otg-rx-mode"


HTML_PAGE = r"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>OTG Ground Station</title>
<style>
