<script>
async function api(path, body) {
  const opt = body ? {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body)} : {};
  const res = await fetch(path, opt);
  const data = await res.json();
  if (!res.ok || data.ok === false) throw new Error(data.error || data.stderr || 'request failed');
  return data;
}
function text(v) { return (v === undefined || v === null) ? '' : String(v); }
function setBadge(el, label, cls) { el.className = 'badge ' + (cls || ''); el.textContent = label; }
async function refresh() {
  try {
    const s = await api('/api/status');
    setBadge(modeBadge, 'mode ' + text(s.rx_mode || 'unknown'), s.rx_mode === 'apfpv' || s.rx_mode === 'wfb' ? 'ok' : 'warn');
    setBadge(otgBadge, s.otg_special_mode ? 'special OTG' : 'normal mode', s.otg_special_mode ? 'ok' : 'warn');
    modeStatus.textContent = text(s.otg_rx_status);
    if (document.activeElement !== apSsid) apSsid.value = text(s.apfpv.ssid);
    if (document.activeElement !== wfbChannel) wfbChannel.value = text(s.wfb.gs_channel);
    if (document.activeElement !== wfbBandwidth) wfbBandwidth.value = text(s.wfb.bandwidth);
    if (document.activeElement !== wfbTxpower) wfbTxpower.value = text(s.wfb.txpower);
    processes.textContent = text(s.processes);
    interfaces.innerHTML = s.interfaces.map(i => `<tr><td>${i.name}</td><td>${i.state}</td><td>${i.addr}</td></tr>`).join('');
    diagnostics.textContent = text(s.diagnostics);
  } catch (e) {
    setBadge(otgBadge, e.message, 'bad');
  }
}
async function setMode(mode) { await api('/api/rx-mode', {mode}); await refresh(); }
async function saveApfpv() {
  const body = {ssid: apSsid.value};
  if (apPassword.value) body.password = apPassword.value;
  await api('/api/apfpv', body);
  apPassword.value = '';
  await refresh();
}
async function saveWfb() {
  const body = {gs_channel:wfbChannel.value, bandwidth:wfbBandwidth.value, txpower:wfbTxpower.value, adaptivelink:wfbAdaptive.value};
  await api('/api/wfb', body);
  await refresh();
}
async function postAction(action) { await api('/api/action', {action}); await refresh(); }
refresh();
setInterval(refresh, 5000);
