def run_cmd(args, timeout=5):
    try:
        proc = subprocess.run(
            args,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
            check=False,
        )
        return {
            "ok": proc.returncode == 0,
            "code": proc.returncode,
            "stdout": proc.stdout[-6000:],
            "stderr": proc.stderr[-3000:],
        }
    except FileNotFoundError:
        return {"ok": False, "code": 127, "stdout": "", "stderr": f"{args[0]} not found"}
    except subprocess.TimeoutExpired:
        return {"ok": False, "code": 124, "stdout": "", "stderr": "command timed out"}


def first_line(result, default=""):
    out = result.get("stdout", "").strip().splitlines()
    return out[0] if out else default


def get_gsmenu(*args):
    return run_cmd([GSMENU, "get", *args])


def set_gsmenu(*args):
    return run_cmd([GSMENU, "set", *args], timeout=20)


def parse_rx_mode(status_text):
    for line in status_text.splitlines():
        if line.startswith("rx_mode="):
            return line.split("=", 1)[1].strip()
    mode = first_line(get_gsmenu("gs", "system", "rx_mode"), "unknown")
    return mode.strip() or "unknown"


def parse_interfaces(text):
    rows = []
    for line in text.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 2:
            parts.append("")
        if len(parts) >= 3:
            rows.append({
                "name": html.escape(parts[0]),
                "state": html.escape(parts[1]),
                "addr": html.escape(parts[2]),
            })
    return rows


def status_payload():
    rx_status = run_cmd([OTG_RX_MODE, "status"])
    ip_br = run_cmd(["ip", "-br", "addr"])
    iw_dev = run_cmd(["iw", "dev"])
    hdmi = run_cmd(["sh", "-c", "for s in /sys/class/drm/*HDMI*/status; do [ -r \"$s\" ] && echo \"$s=$(cat \"$s\")\"; done"])
    ps = run_cmd(["sh", "-c", "ps | grep -E 'otg-forwarder|wfb|alink|wpa_supplicant|udhcpc|pixelpilot|pp_rk' | grep -v grep || true"])
    return {
        "ok": True,
        "otg_special_mode": os.path.exists("/tmp/otg-fwd-mode"),
        "rx_mode": parse_rx_mode(rx_status.get("stdout", "")),
        "otg_rx_status": rx_status.get("stdout", "") + rx_status.get("stderr", ""),
        "apfpv": {
            "ssid": first_line(get_gsmenu("gs", "apfpv", "ssid")),
        },
        "wfb": {
            "gs_channel": first_line(get_gsmenu("gs", "wfbng", "gs_channel")),
            "bandwidth": first_line(get_gsmenu("gs", "wfbng", "bandwidth")),
            "txpower": first_line(get_gsmenu("gs", "wfbng", "txpower")),
            "adaptivelink": first_line(get_gsmenu("gs", "wfbng", "adaptivelink")),
        },
        "interfaces": parse_interfaces(ip_br.get("stdout", "")),
        "processes": ps.get("stdout", ""),
        "diagnostics": "\n".join([
            "HDMI:",
            hdmi.get("stdout", "").strip() or "none",
            "",
            "iw dev:",
            iw_dev.get("stdout", "").strip() or iw_dev.get("stderr", "").strip() or "none",
        ]),
    }


def json_response(handler, payload, code=200):
    body = json.dumps(payload).encode("utf-8")
    handler.send_response(code)
    handler.send_header("Content-Type", "application/json")
    handler.send_header("Content-Length", str(len(body)))
    handler.send_header("Cache-Control", "no-store")
    handler.end_headers()
    handler.wfile.write(body)


def html_response(handler):
    body = HTML_PAGE.encode("utf-8")
    handler.send_response(200)
    handler.send_header("Content-Type", "text/html; charset=utf-8")
    handler.send_header("Content-Length", str(len(body)))
    handler.send_header("Cache-Control", "no-store")
    handler.end_headers()
    handler.wfile.write(body)


class Handler(BaseHTTPRequestHandler):
    server_version = "otg-webui/0.1"

    def log_message(self, fmt, *args):
        print("%s - %s" % (self.address_string(), fmt % args), flush=True)

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path == "/":
            html_response(self)
        elif path == "/api/status":
            json_response(self, status_payload())
        else:
            json_response(self, {"ok": False, "error": "not found"}, 404)

    def read_json(self):
        length = int(self.headers.get("Content-Length", "0"))
        if length > 4096:
            raise ValueError("request too large")
        raw = self.rfile.read(length).decode("utf-8") if length else "{}"
        return json.loads(raw)

    def do_POST(self):
        try:
            body = self.read_json()
            path = urllib.parse.urlparse(self.path).path
            if path == "/api/rx-mode":
                result = self.handle_rx_mode(body)
            elif path == "/api/apfpv":
                result = self.handle_apfpv(body)
            elif path == "/api/wfb":
                result = self.handle_wfb(body)
            elif path == "/api/action":
                result = self.handle_action(body)
            else:
                json_response(self, {"ok": False, "error": "not found"}, 404)
                return
            json_response(self, result, 200 if result.get("ok") else 400)
        except (ValueError, json.JSONDecodeError) as exc:
            json_response(self, {"ok": False, "error": str(exc)}, 400)

    def handle_rx_mode(self, body):
        mode = str(body.get("mode", ""))
        if mode not in ("apfpv", "wfb"):
            return {"ok": False, "error": "invalid mode"}
        return run_cmd([OTG_RX_MODE, mode], timeout=30)

    def handle_apfpv(self, body):
        outputs = []
        ssid = str(body.get("ssid", "")).strip()
        password = str(body.get("password", "")).strip()
        if ssid:
            outputs.append(set_gsmenu("gs", "apfpv", "ssid", ssid))
        if password:
            outputs.append(set_gsmenu("gs", "apfpv", "password", password))
        if not outputs:
            return {"ok": True, "stdout": "no APFPV changes requested", "stderr": ""}
        return combine(outputs)

    def handle_wfb(self, body):
        mapping = {
            "gs_channel": ("gs", "wfbng", "gs_channel"),
            "bandwidth": ("gs", "wfbng", "bandwidth"),
            "txpower": ("gs", "wfbng", "txpower"),
            "adaptivelink": ("gs", "wfbng", "adaptivelink"),
        }
        outputs = []
        for key, gsmenu_args in mapping.items():
            value = str(body.get(key, "")).strip()
            if value:
                outputs.append(set_gsmenu(*gsmenu_args, value))
        if not outputs:
            return {"ok": True, "stdout": "no WFB changes requested", "stderr": ""}
        return combine(outputs)

    def handle_action(self, body):
        action = str(body.get("action", ""))
        actions = {
            "restart-forwarder": ["/etc/init.d/S99otg-forwarder", "restart"],
            "apfpv-reset": [GSMENU, "set", "gs", "apfpv", "reset"],
        }
        if action not in actions:
            return {"ok": False, "error": "invalid action"}
        return run_cmd(actions[action], timeout=30)


def combine(results):
    return {
        "ok": all(result.get("ok") for result in results),
        "code": max((result.get("code", 0) for result in results), default=0),
        "stdout": "\n".join(result.get("stdout", "") for result in results),
        "stderr": "\n".join(result.get("stderr", "") for result in results),
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--host", default="192.168.5.1")
    parser.add_argument("--port", type=int, default=8080)
    args = parser.parse_args()
    server = ThreadingHTTPServer((args.host, args.port), Handler)
    print(f"otg-webui listening on http://{args.host}:{args.port}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
