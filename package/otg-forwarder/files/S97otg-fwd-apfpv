#!/bin/sh
# Start APFPV receive networking for special OTG forwarder mode by using
# the same gsmenu/ifup path as normal HDMI mode.

[ -f /tmp/otg-fwd-mode ] || exit 0
[ "$(cat /tmp/otg-fwd-rx-mode 2>/dev/null)" = "apfpv" ] || exit 0

echo "Starting special OTG APFPV networking"

if [ ! -x /usr/bin/gsmenu.sh ]; then
	echo "special OTG APFPV: gsmenu.sh not found"
	exit 0
fi

ssid="$(grep -m1 '^[[:space:]]*ssid=' /etc/wpa_supplicant.apfpv.conf 2>/dev/null | cut -d '"' -f 2)"
pass="$(grep -m1 '^[[:space:]]*psk=' /etc/wpa_supplicant.apfpv.conf 2>/dev/null | cut -d '"' -f 2)"
ssid="${ssid:-OpenIPC}"
pass="${pass:-12345678}"

apply_apfpv_mode() {
	/usr/bin/gsmenu.sh set gs system rx_mode apfpv "$ssid" "$pass" || true
}

ifdown_apfpv_ifaces() {
	for conn in /etc/network/interfaces.d/wlx*; do
		[ -f "$conn" ] || continue
		ifdown "$(basename "$conn")" >/dev/null 2>&1 || true
	done
}

has_auto_apfpv_iface() {
	for conn in /etc/network/interfaces.d/wlx*; do
		[ -f "$conn" ] || continue
		grep -q "^auto $(basename "$conn")$" "$conn" && return 0
	done
	return 1
}

ifdown_apfpv_ifaces
apply_apfpv_mode

for _ in $(seq 1 60); do
	if ps | grep '[w]pa_supplicant' >/dev/null 2>&1 || ps | grep '[u]dhcpc' >/dev/null 2>&1; then
		break
	fi
	if ! has_auto_apfpv_iface && ls /sys/class/net/wlx* >/dev/null 2>&1; then
		apply_apfpv_mode
	fi
	for conn in /etc/network/interfaces.d/wlx*; do
		[ -f "$conn" ] || continue
		if grep -q "^auto $(basename "$conn")$" "$conn"; then
			if ifup "$(basename "$conn")" >/dev/null 2>&1; then
				break
			fi
		fi
	done
	sleep 1
done

exit 0
